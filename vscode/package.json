{
  "name": "apl-lang-simple",
  "displayName": "APL - VSCode language support and simple analysis",
  "description": "VS Code extention for APL",
  "icon": "./apl.png",
  "version": "0.2.1",
  "publisher": "11adyy",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/11adyy/AdyCompiler.PETPRJ.git"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:apl",
    "onCommand:apl.runModuleTest",
    "onCommand:extension.sayHello"
  ],
  "contributes": {
    "languages": [
      {
        "id": "apl",
        "aliases": [
          "APL", "apl"
        ],
        "extensions": [
          ".apl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./apl.png",
          "dark": "./apl.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "apl",
        "scopeName": "source.apl",
        "path": "./syntaxes/apl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "apl",
        "path": "./snippets/apl.json"
      }
    ],
    "themes": [
      {
        "label": "APL Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/apl-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "apl.runModuleTest",
        "title": "Run APL Module Test",
        "category": "APL",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "apl.runModuleTest",
          "when": "resourceLangId == apl",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "apl.runModuleTest",
          "when": "resourceLangId == apl",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "apl.runModuleTest",
          "when": "resourceExtname == .apl",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.9.0",
    "@types/vscode": "^1.80.0",
    "vsce": "^2.15.0"
  }
}
