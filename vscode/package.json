{
  "name": "apl-lang-simple",
  "displayName": "APL - VSCode language support and simple analysis",
  "description": "VS Code extention for APL",
  "icon": "./apl.png",
  "version": "0.2.1",
  "publisher": "11adyy",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/11adyy/AdyCompiler.PETPRJ.git"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:apl",
    "onCommand:extension.sayHello"
  ],
  "contributes": {
    "languages": [
      {
        "id": "apl",
        "aliases": [
          "APL", "apl"
        ],
        "extensions": [
          ".apl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./apl.png",
          "dark": "./apl.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "apl",
        "scopeName": "source.apl",
        "path": "./syntaxes/apl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "apl",
        "path": "./snippets/apl.json"
      }
    ],
    "themes": [
      {
        "label": "APL Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/apl-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.9.0",
    "@types/vscode": "^1.80.0",
    "vsce": "^2.15.0"
  }
}