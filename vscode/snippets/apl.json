{
  "program-start": {
    "scope": "apl",
    "prefix": "start",
    "body": [
      "{",
      "\tstart(long argc, ptr long argv) {",
      "\t\t$0",
      "\t\texit ${1:0};",
      "\t}",
      "}"
    ],
    "description": "APL program skeleton"
  },
  "function-definition": {
    "scope": "apl",
    "prefix": "function",
    "body": [
      "function name(: ... :) {",
      "\t: ... :",
      "\treturn 0;",
      "} : -> type :"
    ]
  },
  "if-statement": {
    "scope": "apl",
    "prefix": "if",
    "body": [
      "if cond; {",
      "\t: ... :",
      "}",
      "else {",
      "\t: ... :",
      "}"
    ]
  },
  "while-loop": {
    "scope": "apl",
    "prefix": "while",
    "body": [
      "while cond; {",
      "\t: ... :",
      "}",
      "else {",
      "\t: ... :",
      "}"
    ]
  },
  "syscall-invoke": {
    "scope": "apl",
    "prefix": "syscall",
    "body": [
      "syscall(arg, ...);"
    ]
  },
  "switch-statement": {
    "scope": "apl",
    "prefix": "switch",
    "body": [
      "switch cond; {",
      "\tcase ...; {",
      "\t\t: ... :",
      "\t}",
      "\tdefault {",
      "\t\t: ... :",
      "\t}",
      "}"
    ]
  },
