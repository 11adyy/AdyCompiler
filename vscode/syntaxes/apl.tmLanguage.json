{
  "name": "APL",
  "scopeName": "source.apl",
  "fileTypes": [
    "apl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functionDefinitions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#genericTypes"
    },
    {
      "include": "#types"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.apl",
          "begin": ":/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.apl"
            }
          },
          "end": "/:",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.apl"
            }
          }
        },
        {
          "name": "comment.block.apl",
          "begin": ":",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.apl"
            }
          },
          "end": ":",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.apl"
            }
          }
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.apl",
          "begin": "@(\\[)",
          "beginCaptures": {
            "0": {
              "name": "meta.annotation.apl"
            },
            "1": {
              "name": "punctuation.definition.annotation.begin.apl"
            }
          },
          "end": "(\\])",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.annotation.end.apl"
            }
          },
          "contentName": "storage.type.annotation.apl"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.apl",
          "begin": "^(\\s*)(#)\\s*(?=(?:line|include|define|undef|ifdef|ifndef|endif)\\b)",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.directive.apl"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "keyword.control.directive.apl",
              "match": "\\b(line|include|define|undef|ifdef|ifndef|endif)\\b"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#types"
            },
            {
              "include": "#modifiers"
            },
            {
              "include": "#variables"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.function.apl",
          "match": "\\b(function|container)\\b"
        },
        {
          "name": "keyword.control.apl",
          "match": "\\b(start|exit|return|if|else|loop|while|switch|case|default|break)\\b"
        },
        {
          "name": "keyword.other.import.apl",
          "match": "\\b(from|import)\\b"
        },
        {
          "name": "keyword.other.extern.apl",
          "match": "\\bextern\\b"
        },
        {
          "name": "keyword.other.layout.apl",
          "match": "\\b(section|align)\\b"
        },
        {
          "name": "keyword.other.apl",
          "match": "\\b(syscall|asm|lis|poparg)\\b"
        },
        {
          "name": "keyword.other.operatorlike.apl",
          "match": "\\b(as|ref|dref|not|neg)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.apl",
          "match": "\\b(f64|f32|i64|i32|i16|i8|u64|u32|u16|u8|i0)\\b"
        },
        {
          "name": "storage.type.other.apl",
          "match": "\\b(str|arr|ptr)\\b"
        },
        {
          "name": "storage.type.user.apl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*(?:=|;|,|\\)|\\[))"
        },
        {
          "name": "meta.array.element-type.apl",
          "match": "(,\\s*)([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\])",
          "captures": {
            "2": {
              "name": "storage.type.user.apl"
            }
          }
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.apl",
          "match": "\\b(ro|glob)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.type.container.apl",
          "match": "(?<=\\bcontainer\\s+)[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.definition.apl",
          "match": "(?<=\\bfunction\\s+)[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "meta.function.call.generic.apl",
          "begin": "\\b(?!if\\b|while\\b|switch\\b|asm\\b|syscall\\b|start\\b|function\\b|container\\b|section\\b|align\\b)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(<)(?=[^>\\r\\n]*>\\s*\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.call.apl"
            },
            "3": {
              "name": "punctuation.definition.generic.begin.apl"
            }
          },
          "end": ">",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.generic.end.apl"
            }
          },
          "patterns": [
            {
              "include": "#types"
            },
            {
              "include": "#genericTypes"
            },
            {
              "name": "punctuation.separator.generic.apl",
              "match": ","
            }
          ]
        },
        {
          "name": "entity.name.function.call.apl",
          "match": "\\b(?!if\\b|while\\b|switch\\b|asm\\b|syscall\\b|start\\b|function\\b|container\\b|section\\b|align\\b)[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*(?:<[^>\\r\\n]*>\\s*)?\\()"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.apl",
          "match": "\"([^\"\\\\\\r\\n]|\\\\.)*\""
        },
        {
          "name": "string.quoted.single.apl",
          "match": "'([^'\\\\\\r\\n]|\\\\.)*'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.apl",
          "match": "\\b(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?\\b|\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.apl",
          "match": "\\b(0[xX][0-9a-fA-F]+|0[bB][01]+|[0-9]+)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.definition.apl",
          "match": "\\barr\\s+([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\[)",
          "captures": {
            "1": {
              "name": "variable.other.definition.apl"
            }
          }
        },
        {
          "name": "variable.other.definition.apl",
          "match": "\\barr\\s*\\[[^\\]\\r\\n]+\\]\\s+([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?:=|;|,|\\)))",
          "captures": {
            "1": {
              "name": "variable.other.definition.apl"
            }
          }
        },
        {
          "name": "variable.other.definition.apl",
          "match": "\\b(?:ptr\\s+)+(?:f64|f32|i64|i32|i16|i8|u64|u32|u16|u8|i0|str)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?:=|;|,|\\)|\\[))",
          "captures": {
            "1": {
              "name": "variable.other.definition.apl"
            }
          }
        },
        {
          "name": "variable.other.definition.apl",
          "match": "\\b(?:f64|f32|i64|i32|i16|i8|u64|u32|u16|u8|i0|str)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?:=|;|,|\\)|\\[))",
          "captures": {
            "1": {
              "name": "variable.other.definition.apl"
            }
          }
        },
        {
          "name": "variable.parameter.apl",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?:=|,|\\)))"
        },
        {
          "name": "variable.other.apl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functionDefinitions": {
      "patterns": [
        {
          "name": "meta.function.definition.apl",
          "begin": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*<)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.function.apl"
            },
            "2": {
              "name": "entity.name.function.definition.apl"
            },
            "3": {
              "name": "punctuation.definition.generic.begin.apl"
            }
          },
          "end": ">",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.generic.end.apl"
            }
          },
          "patterns": [
            {
              "name": "storage.type.generic.apl",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.generic.apl",
              "match": ","
            }
          ]
        }
      ]
    },
    "genericTypes": {
      "patterns": [
        {
          "name": "storage.type.generic.apl",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "storage.type.generic.apl",
          "match": "(?<=<)\\s*\\b[A-Z][A-Za-z0-9_]*\\b(?=\\s*(?:,|>))"
        },
        {
          "name": "storage.type.generic.apl",
          "match": "(?<=,)\\s*\\b[A-Z][A-Za-z0-9_]*\\b(?=\\s*(?:,|>))"
        }
      ]
    }
  }
}
