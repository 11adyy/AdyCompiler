complete -c aplc -l emit-lir-cfg -r -d "Emit LIR CFG dump for function"
complete -c aplc -l emit-asm -d "Emit produced assembly code"
complete -c aplc -l ast-output -r -F -d "Set AST dump output path"
complete -c aplc -l ir-output -r -F -d "Set HIR dump output path"
complete -c aplc -l lir-output -r -F -d "Set LIR dump output path"
complete -c aplc -l asm-output -r -F -d "Set assembly output path"
complete -c aplc -s L -r -a "(__fish_complete_directories)" -d "Add linker library search directory"
