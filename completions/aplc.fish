# fish completion for aplc.

complete -c aplc -s h -l help -d "Show this help message"
complete -c aplc -s v -l version -d "Show compiler version"
complete -c aplc -s s -l smth -d "Show something"
complete -c aplc -s E -d "Run preprocessor only"
complete -c aplc -s I -r -a "(__fish_complete_directories)" -d "Add include directory"
complete -c aplc -s D -r -d "Define preprocessor variable"
complete -c aplc -l print-stdlib-path -d "Print the standard library directory"
complete -c aplc -l output -r -F -d "Set output file"
complete -c aplc -l ast-analysis -d "Enable AST analysis"
complete -c aplc -l ir-analysis -d "Enable IR analysis"
complete -c aplc -l analysis-only -d "Run AST and HIR analysis, then stop before code generation"
complete -c aplc -l debug -d "Enable debug mode"
complete -c aplc -l no-debug -d "Disable debug mode"
complete -c aplc -l i-know-what-i-am-doing -d "Keep compiling after static analysis warnings"
complete -c aplc -o O0 -d "Disable optimizations"
complete -c aplc -o O1 -d "Rough optimization level"
