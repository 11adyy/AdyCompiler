complete -c aplc -l linker-arg -r -d "Pass one raw argument to the linker command"
complete -c aplc -s c -l compile-only -d "Build an object file and skip linking"
complete -c aplc -l linker-no-pie -d "Disable PIE"
complete -c aplc -l linker-pie -d "Enable PIE"
complete -c aplc -l linker-m32 -d "Enable m32 mode"
complete -c aplc -l linker-no-m32 -d "Disable m32 mode"
complete -c aplc -l entry-name -r -d "Set entry symbol name"
complete -c aplc -l ro-section -r -d "Set read-only section name"
complete -c aplc -l glob-section -r -d "Set global section name"
complete -c aplc -l code-section -r -d "Set code section name"
complete -c aplc -l full-bytness -r -a "1 2 4 8" -d "Set full bytness"
complete -c aplc -l half-bytness -r -a "1 2 4 8" -d "Set half bytness"
complete -c aplc -l quart-bytness -r -a "1 2 4 8" -d "Set quart bytness"
complete -c aplc -l eight-bytness -r -a "1 2 4 8" -d "Set eight bytness"
complete -c aplc -l sys-type -r -a "unknown macho64 linux64 i386 windows64" -d "Set system type"
complete -c aplc -l tre -d "Enable TRE"
complete -c aplc -l no-tre -d "Disable TRE"
complete -c aplc -l finline -d "Enable function inlining"
complete -c aplc -l no-finline -d "Disable function inlining"
complete -c aplc -l licm -d "Enable LICM"
complete -c aplc -l no-licm -d "Disable LICM"
complete -c aplc -l constant -d "Enable constant propagation/folding"
complete -c aplc -l no-constant -d "Disable constant propagation/folding"
complete -c aplc -l copyprop -d "Enable LIR copy propagation"
complete -c aplc -l no-copyprop -d "Disable LIR copy propagation"
complete -c aplc -l peephole -d "Enable peephole optimization"
complete -c aplc -l no-peephole -d "Disable peephole optimization"
complete -c aplc -l emit-ast -d "Emit AST dump"
complete -c aplc -l emit-ir -d "Emit HIR dump"
